# ==============================================================================
# Git Ignore Rules — Loan Intelligence Platform
# ==============================================================================

# Python compilation & test artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
coverage/
htmlcov/
.Python
env/
venv/
.venv/

# Operational SQLite databases, transactions & WAL journals
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# Node dependencies & Frontend production build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test downloads, generated screenshots & run logs
reports/test_downloads/
reports/screenshots/
reports/reproducibility/
*.log

# Secrets & local environment overrides
.env
.env.local
.env.*.local
!.env.example

# IDE, OS & Editor configuration
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
